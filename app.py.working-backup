    if st.button("Calculate illustrative ECL", type="primary"):
        if not np.isclose(weights_sum, 1.0, atol=1e-6):
            st.error("Scenario weights must sum to 100%.")
        else:
            scenarios = [
                {"name":"Base", "weight":w_base, "pd_multiplier":1.0},
                {"name":"Upside", "weight":w_up, "pd_multiplier":mult_up},
                {"name":"Downside", "weight":w_down, "pd_multiplier":mult_down},
            ]
            output = calculate_ecl(pd_base, lgd, ead, eir, horizon, scenarios)
            st.metric("Scenario-weighted discounted ECL", f"₹{output['weighted_discounted_ecl']:,.2f}")
            st.dataframe(pd.DataFrame(output["scenarios"]), use_container_width=True)
            st.write(f"Illustrative treatment selected: **{stage}**. Stage selection does not automatically determine the correct PD horizon in this demo; ensure the PD input matches your policy assumption.")
