        with st.form("train_form"):
            candidates = st.multiselect("Models to compare", ["Logistic Regression", "Random Forest", "HistGradientBoosting"], default=["Logistic Regression", "Random Forest", "HistGradientBoosting"])
            test_size = st.slider("Holdout test fraction", min_value=0.15, max_value=0.35, value=0.20, step=0.05)
            cv_folds = st.select_slider("Cross-validation folds", options=[3, 4, 5], value=5)
            seed = st.number_input("Random seed", min_value=1, max_value=99999, value=42, step=1)
            threshold = st.slider("Decision threshold for confusion matrix", 0.05, 0.95, 0.50, 0.05)
            submitted = st.form_submit_button("Train and compare models", type="primary", use_container_width=True)
        if submitted:
            if not candidates:
                st.error("Select at least one model.")
            else:
                with st.spinner("Training models and cross-validating. This may take a few minutes..."):
                    try:
                        result = train_and_compare(data, target, candidates, test_size=float(test_size), cv_folds=int(cv_folds), random_state=int(seed), threshold=float(threshold))
                        st.session_state.training_result = result
                        st.success("Training completed. The winner is selected by cross-validated average precision (PR-AUC), not holdout performance.")
                    except Exception as exc:
                        st.exception(exc)
        result = st.session_state.training_result
        if result:
            summary = result["summary"].copy()
            st.markdown("### Cross-validation comparison")
            st.dataframe(summary.style.format({c:"{:.4f}" for c in summary.select_dtypes(include="number").columns}), use_container_width=True)
            winner = result["winner_name"]
            st.success(f"Selected candidate: {winner} · selection metric: mean CV PR-AUC")
            metrics = result["holdout_metrics"]
            cols = st.columns(5)
            for col, label, key in zip(cols, ["ROC-AUC", "PR-AUC", "Brier score", "Recall", "F1"], ["roc_auc", "pr_auc", "brier", "recall", "f1"]):
                col.metric(label, f"{metrics.get(key, float('nan')):.4f}")
            st.caption("These are holdout estimates from this split, not proof of future performance. Brier score is better when lower.")
            cm = confusion_matrix(result["y_test"], result["holdout_pred"], labels=[0,1])
            st.plotly_chart(px.imshow(cm, text_auto=True, x=["Predicted non-default","Predicted default"], y=["Actual non-default","Actual default"], color_continuous_scale="Blues", title="Holdout confusion matrix", template="plotly_dark"), use_container_width=True)
            fpr, tpr, _ = roc_curve(result["y_test"], result["holdout_prob"])
            st.plotly_chart(px.area(x=fpr, y=tpr, title="Holdout ROC curve", labels={"x":"False positive rate","y":"True positive rate"}, template="plotly_dark"), use_container_width=True)
            st.markdown("#### Classification report")
            report = classification_report(result["y_test"], result["holdout_pred"], labels=[0,1], target_names=["Non-default","Default"], output_dict=True, zero_division=0)
            st.dataframe(pd.DataFrame(report).T, use_container_width=True)
            st.markdown("#### Permutation importance")
            imp = result["importance"]
            if imp is not None and not imp.empty:
                st.plotly_chart(px.bar(imp.head(20).sort_values("importance_mean"), x="importance_mean", y="feature", error_x="importance_std", orientation="h", title="Holdout permutation importance (ROC-AUC scoring)", template="plotly_dark"), use_container_width=True)
            bundle = {
                "model": result["winner_model"],
                "features": result["features"],
                "target": result["target"],
                "model_name": winner,
                "threshold": result["threshold"],
                "metrics": result["holdout_metrics"],
                "summary": result["summary"].to_dict(orient="records"),
                "random_state": result["random_state"],
            }
            import joblib
            model_bytes = io.BytesIO()
            joblib.dump(bundle, model_bytes)
            st.download_button("Download trained model bundle (.joblib)", model_bytes.getvalue(), "creditiq_model_bundle.joblib", "application/octet-stream")
