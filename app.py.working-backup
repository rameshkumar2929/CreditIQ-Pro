elif page == "Borrower Risk":
    data = get_data()
    result = st.session_state.training_result
    st.header("Borrower Risk Analyzer")
    if data is None:
        st.info("Load a dataset first.")
    elif not result:
        st.info("Train at least one model in Model Lab first.")
    else:
        st.caption("This is an illustrative model score. Do not use it as the sole basis for credit decisions.")
        features = result["features"]
        target = result["target"]
        input_values = {}
        numeric_cols = [c for c in features if pd.api.types.is_numeric_dtype(data[c])]
        categorical_cols = [c for c in features if c not in numeric_cols]
        st.markdown("#### Enter feature values")
        with st.form("borrower_form"):
            left, right = st.columns(2)
            for i, col in enumerate(numeric_cols):
                series = pd.to_numeric(data[col], errors="coerce").dropna()
                if series.empty:
                    default, lo, hi = 0.0, -1e6, 1e6
                else:
                    default = float(series.median())
                    lo, hi = float(series.min()), float(series.max())
                    if lo == hi:
                        lo, hi = lo-1.0, hi+1.0
                with (left if i % 2 == 0 else right):
                    input_values[col] = st.number_input(col, min_value=float(lo), max_value=float(hi), value=float(np.clip(default, lo, hi)), key=f"risk_{col}")
            for col in categorical_cols:
                vals = data[col].dropna().astype(str).unique().tolist()
                if vals:
                    input_values[col] = st.selectbox(col, sorted(vals), key=f"cat_{col}")
                else:
                    input_values[col] = ""
            submitted = st.form_submit_button("Estimate default probability", type="primary", use_container_width=True)
        if submitted:
            row = pd.DataFrame([{c: input_values.get(c, np.nan) for c in features}])
            try:
                pd_default = float(predict_default_probability(result["winner_model"], row)[0])
                threshold = float(result["threshold"])
                st.metric("Estimated probability of default", f"{pd_default:.1%}")
                st.progress(min(max(pd_default, 0.0), 1.0))
                st.write(f"At threshold **{threshold:.2f}**, model classification: **{'Default-risk class' if pd_default >= threshold else 'Non-default-risk class'}**.")
                st.caption("A probability estimate is not a certainty. Validate calibration and decision thresholds before operational use.")
                try:
                    from sklearn.inspection import permutation_importance
                    pi = permutation_importance(result["winner_model"], data[features], data[target].astype(int), n_repeats=3, random_state=42, scoring="roc_auc", n_jobs=1)
                    local = pd.DataFrame({"feature": features, "importance_mean": pi.importances_mean}).sort_values("importance_mean", ascending=False).head(8)
                    st.markdown("#### Global feature importance context")
                    st.dataframe(local, use_container_width=True)
                except Exception:
                    pass
            except Exception as exc:
                st.error(f"Prediction failed: {exc}")

